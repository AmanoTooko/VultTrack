{
  "name": "vultrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node plugins/fetchers/run-fetcher.mjs",
    "fetch:all:smoke": "FETCHER_MAX_RECORDS=2 node plugins/fetchers/run-all.mjs",
    "normalize:run": "node scripts/run-full-normalization.mjs",
    "normalize:parallel": "node scripts/run-parallel-normalization.mjs",
    "normalize:canonical-rebuild": "node scripts/run-canonical-rebuild-normalization.mjs",
    "normalize:sources": "node scripts/normalize-source-smoke.mjs",
    "detail:snapshot": "node scripts/build-detail-snapshot.mjs",
    "benchmark:matching": "node scripts/benchmark-matching-quality.mjs",
    "benchmark:trivy": "node scripts/benchmark-trivy-sbom.mjs",
    "benchmark:api": "node scripts/api-performance-check.mjs",
    "benchmark:init": "node scripts/benchmark-fresh-init.mjs",
    "benchmark:duckdb": "node scripts/benchmark-duckdb-normalization.mjs",
    "benchmark:duckdb:compare": "python3 scripts/compare-duckdb-pg-detail.py",
    "ai:input": "node scripts/preview-ai-summary-input.mjs",
    "audit:canonical": "node scripts/audit-canonical-integrity.mjs",
    "audit:snapshot": "node scripts/audit-detail-snapshot.mjs",
    "detail:snapshot:full": "node scripts/rebuild-detail-snapshot-full.mjs",
    "audit:storage": "node scripts/audit-database-storage.mjs",
    "smoke:canonical": "node scripts/smoke-canonical-integrity.mjs",
    "rebuild:canonical": "node scripts/rebuild-canonical-data.mjs",
    "reset:exploit-intelligence": "node scripts/reset-exploit-intelligence.mjs",
    "lint": "eslint plugins scripts tests src/VulTrack.App/wwwroot",
    "test": "node --test tests/node/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.3",
    "pg": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0"
  }
}
