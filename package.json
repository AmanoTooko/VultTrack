{
  "name": "vultrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:local": "bash scripts/start-local.sh",
    "bootstrap:duckdb": "node scripts/bootstrap-duckdb.mjs",
    "spool:ingest": "node scripts/ingest-duckdb-spool.mjs",
    "ai:import-duckdb": "node scripts/import-duckdb-ai.mjs",
    "status": "node scripts/status-local.mjs",
    "fetch": "node plugins/fetchers/run-fetcher.mjs",
    "fetch:all:smoke": "FETCHER_MAX_RECORDS=2 node plugins/fetchers/run-all.mjs",
    "benchmark:matching": "node scripts/benchmark-matching-quality.mjs",
    "benchmark:trivy": "node scripts/benchmark-trivy-sbom.mjs",
    "benchmark:api": "node scripts/api-performance-check.mjs",
    "benchmark:duckdb": "node scripts/benchmark-duckdb-normalization.mjs",
    "ai:input": "node scripts/preview-ai-summary-input.mjs",
    "lint": "eslint plugins scripts tests src/VulTrack.App/wwwroot",
    "test": "node --test tests/node/*.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0"
  }
}
