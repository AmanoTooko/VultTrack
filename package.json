{
  "name": "vultrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node plugins/fetchers/run-fetcher.mjs",
    "fetch:all:smoke": "FETCHER_MAX_RECORDS=2 node plugins/fetchers/run-all.mjs",
    "normalize:run": "node scripts/run-full-normalization.mjs",
    "normalize:parallel": "node scripts/run-parallel-normalization.mjs",
    "normalize:sources": "node scripts/normalize-source-smoke.mjs",
    "test": "node --test tests/node/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "yaml": "^2.8.4"
  }
}
