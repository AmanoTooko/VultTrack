VULTRACK_ENV=development
DATABASE_URL=postgres://vultrack:vultrack@localhost:5432/vultrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vultrack
POSTGRES_USER=vultrack
POSTGRES_PASSWORD=vultrack

RAW_OBJECT_STORE=filesystem
RAW_OBJECT_PATH=./data/raw-objects

FETCHER_TIMEOUT_MS=120000
FETCHER_MAX_RECORDS=

NVD_API_KEY=
GITHUB_TOKEN=
OSS_INDEX_USERNAME=
OSS_INDEX_TOKEN=

# Bounded package/ecosystem fetcher inputs
NPM_PACKAGES=lodash,express,react
NPM_AUDIT_PACKAGES=lodash@4.17.20,express@4.17.1,react@16.0.0
PYPI_PACKAGES=django,requests,urllib3
MAVEN_COMPONENTS=org.apache.logging.log4j:log4j-core@2.14.1,org.springframework:spring-core@5.3.17
NUGET_PACKAGES=Newtonsoft.Json,NuGet.Protocol,Serilog
RUBYGEMS_PACKAGES=rails,rack,nokogiri
PACKAGIST_PACKAGES=laravel/framework,symfony/symfony,monolog/monolog
CRATES_PACKAGES=serde,tokio,rand
ANDROID_OSV_IDS=ASB-A-111893654,ASB-A-112551163
GOOGLE_OSV_IDS=ASB-A-111893654,ASB-A-112551163
UBUNTU_OSV_IDS=UBUNTU-CVE-2002-2443,UBUNTU-CVE-2004-2771

# Fetcher mirror paths (optional, for bulk init downloads)
CVE_LIST_LOCAL_PATH=./data/mirrors/cvelistV5
PYPI_ADVISORY_PATH=./data/mirrors/pypi-advisory-db

VULTRACK_SCHEDULER_ENABLED=false
ASPNETCORE_URLS=http://0.0.0.0:8080
