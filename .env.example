VULTRACK_ENV=development
VULTRACK_ADMIN_USERNAME=admin
VULTRACK_ADMIN_PASSWORD=change-me
VULTRACK_STORAGE_BACKEND=duckdb
VULTRACK_DUCKDB_ENABLED=true
VULTRACK_DUCKDB_PATH=./data/duckdb/vultrack-evidence.duckdb
# DuckDB resource limits. Container mem_limit is 5g, so keep the DuckDB memory
# limit below that to leave headroom for the .NET runtime and read pool.
VULTRACK_DUCKDB_MEMORY_LIMIT=3g
# DuckDB worker threads per connection (clamped to 1-32 by the app).
VULTRACK_DUCKDB_THREADS=4
VULTRACK_SPOOL_PATH=./data/spool

FETCHER_TIMEOUT_MS=120000
FETCHER_MAX_RECORDS=
# Nuclei only accepts a complete non-empty revision. Protect the active template
# set from an unexpected shrink; override only after verifying the upstream revision.
NUCLEI_ALLOW_LARGE_SNAPSHOT_DROP=false
NUCLEI_LARGE_SNAPSHOT_DROP_THRESHOLD=0.5
EXPLOITDB_ARCHIVE_ARTIFACTS=0

NVD_API_KEY=
GITHUB_TOKEN=
OSS_INDEX_USERNAME=
OSS_INDEX_TOKEN=

# Bounded package/ecosystem fetcher inputs. Keep blank in shared env files;
# set them only for targeted debugging/query fetchers.
NPM_PACKAGES=
NPM_AUDIT_PACKAGES=
PYPI_PACKAGES=
MAVEN_COMPONENTS=
NUGET_PACKAGES=
RUBYGEMS_PACKAGES=
PACKAGIST_PACKAGES=
CRATES_PACKAGES=
OSV_IDS=
MAVEN_OSV_IDS=
ANDROID_OSV_IDS=
GOOGLE_OSV_IDS=
UBUNTU_OSV_IDS=

# Fetcher mirror paths (optional, for bulk init downloads)
CVE_LIST_LOCAL_PATH=./data/mirrors/cvelistV5
PYPI_ADVISORY_PATH=./data/mirrors/pypi-advisory-db
# ghsa-init shallow-clones the official GitHub Advisory Database and imports
# only advisories/github-reviewed. Override these for a local mirror or tests.
GHSA_ADVISORY_REPOSITORY=https://github.com/github/advisory-database.git
GHSA_ADVISORY_MIRROR_PATH=./data/mirrors/github-advisory-database
GHSA_INIT_SEGMENT_SIZE=5000

# Keep writes disabled for the first start. Complete intentional baselines and
# verify status/coverage before enabling scheduled incremental fetches.
VULTRACK_SCHEDULER_ENABLED=false
# The global OSV feed already carries ecosystem-specific ranges for Debian,
# Ubuntu, Alpine, Maven, npm, PyPI, Go, NuGet, and other package databases.
# Keep direct feeds here only when they add independent evidence or exploits.
DUCKDB_FETCH_SOURCES=nvd-cve,osv,ghsa,google-osv,cnnvd,cisa-kev,first-epss,exploitdb,nuclei-templates,metasploit,poc-in-github,cargo-advisory
# GHSA incremental sync works unauthenticated for small increments. The official
# repository-backed ghsa-init baseline does not require a GitHub API token.
# GITHUB_TOKEN=
# google-osv requires a one-time baseline: npm run fetch -- --source google-osv-init
# Manual-only sources (fragile HTML scraping or credentials): cnvd (CNVD_COOKIE),
# seebug, aliyun-avd, nsfocus-vulndb, chaitin-vuldb, cert-360, cve-list-v5 (377k-file init)
DUCKDB_FETCH_INTERVAL_SECONDS=3600
DUCKDB_FETCH_INITIAL_DELAY_SECONDS=15
DUCKDB_ALLOW_AUTOMATIC_INIT=false
OSV_FETCH_MAX_RECORDS=5000
OSV_FETCH_CONCURRENCY=8
OSV_PENDING_MAX_BATCHES_PER_CYCLE=6

VULTRACK_AI_ENABLED=false
VULTRACK_AI_BASE_URL=
VULTRACK_AI_API_KEY=
VULTRACK_AI_MODEL=openai/gpt-5.5
VULTRACK_AI_LANGUAGE=en-US
VULTRACK_AI_MAX_INPUT_CHARS=12000
VULTRACK_AI_MAX_OUTPUT_TOKENS=1400
VULTRACK_AI_ANALYSIS_PROMPT_VERSION=vultrack-ai-analysis-automotive-v4
VULTRACK_AI_ANALYSIS_SYSTEM_PROMPT_PATH=prompts/vulnerability-analysis-batch.system.md
VULTRACK_AI_PROMPT_CACHE_KEY=
VULTRACK_AI_PROMPT_CACHE_RETENTION=

SCHEDULER_INTERVAL_SECONDS=15
SCHEDULER_FETCH_TIMEOUT_SECONDS=7200
SCHEDULER_FETCH_PARALLELISM=2
FETCHER_HTTP_RETRIES=3
FETCHER_HTTP_RETRY_BASE_MS=1000
NVD_PAGE_SIZE=1000
EPSS_BATCH_SIZE=25000
# FIRST EPSS is disabled from the default scheduler until its compact delta
# sidecar is explicitly initialized. These limits prevent another daily spool flood.
EPSS_DELTA_MAX_ROWS=600000
EPSS_DELTA_MAX_CHANGED_ROWS=50000
EPSS_DELTA_MAX_STATE_BYTES=33554432
EPSS_DELTA_ALLOW_BASELINE=false
EPSS_DELTA_ALLOW_BULK=false
SCHEDULER_FETCH_LIMIT=
SCHEDULER_NORMALIZE_LIMIT=5000
SCHEDULER_SOURCE_CODES=
SCHEDULER_INCLUDE_INIT_SOURCES=false
SCHEDULER_DETAIL_SNAPSHOT_QUEUE_ENABLED=true
SCHEDULER_DETAIL_SNAPSHOT_QUEUE_INTERVAL_SECONDS=60
SCHEDULER_DETAIL_SNAPSHOT_QUEUE_LIMIT=5000
SCHEDULER_DETAIL_SNAPSHOT_QUEUE_CONCURRENCY=8
SCHEDULER_DUCKDB_AFFECTED_QUEUE_LIMIT=1000
SCHEDULER_DETAIL_SNAPSHOT_GZIP_LEVEL=4
PLUGIN_NODE_BIN=node
ASPNETCORE_URLS=http://0.0.0.0:8080
