{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VulTrack": {
    "NormalizerBackend": "duckdb",
    "DuckDb": {
      "Enabled": true,
      "Path": "data/duckdb/vultrack-evidence.duckdb"
    },
    "AI": {
      "Enabled": false,
      "BaseUrl": "",
      "Model": "gemini-3.1-pro-preview",
      "PromptVersion": "vultrack-ai-summary-v1",
      "Language": "zh-CN",
      "MaxInputChars": 12000,
      "MaxOutputTokens": 1100
    },
    "Scheduler": {
      "Enabled": false,
      "NormalizeIntervalSeconds": 15,
      "FetchIntervalHours": 12,
      "NormalizeLimit": 5000,
      "FetchTimeoutSeconds": 1800,
      "FetchLimit": null,
      "PluginNodeBin": "node",
      "SourceCodes": [],
      "IncludeInitSources": false,
      "NormalizeParallelism": 1,
      "DetailSnapshotQueueEnabled": true,
      "DetailSnapshotQueueIntervalSeconds": 60,
      "DetailSnapshotQueueLimit": 5000,
      "DetailSnapshotQueueConcurrency": 8,
      "DetailSnapshotGzipLevel": 4
    }
  },
  "AllowedHosts": "*"
}
