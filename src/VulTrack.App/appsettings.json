{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VulTrack": {
    "NormalizerBackend": "duckdb",
    "DuckDb": {
      "Enabled": true,
      "Path": "data/duckdb/vultrack-evidence.duckdb",
      "NormalizeLimit": 5000,
      "NormalizeBatchSize": 1000,
      "InlineNormalizeLimit": 5000
    },
    "AI": {
      "Enabled": false,
      "BaseUrl": "",
      "Model": "openai/gpt-5.5",
      "PromptVersion": "vultrack-ai-analysis-automotive-v4",
      "AnalysisPromptVersion": "vultrack-ai-analysis-automotive-v4",
      "AnalysisSystemPromptPath": "prompts/vulnerability-analysis-batch.system.md",
      "Language": "en-US",
      "MaxInputChars": 12000,
      "MaxOutputTokens": 1400
    },
    "Scheduler": {
      "Enabled": false,
      "NormalizeIntervalSeconds": 15,
      "FetchIntervalHours": 12,
      "NormalizeLimit": 5000,
      "FetchTimeoutSeconds": 1800,
      "FetchParallelism": 2,
      "FetchLimit": null,
      "PluginNodeBin": "node",
      "SourceCodes": [],
      "IncludeInitSources": false,
      "NormalizeParallelism": 1,
      "DetailSnapshotQueueEnabled": true,
      "DetailSnapshotQueueIntervalSeconds": 60,
      "DetailSnapshotQueueLimit": 5000,
      "DetailSnapshotQueueConcurrency": 8,
      "DetailSnapshotGzipLevel": 4,
      "DuckDbAffectedQueueEnabled": true,
      "DuckDbAffectedQueueIntervalSeconds": 60,
      "DuckDbAffectedQueueLimit": 1000,
      "DuckDbAffectedQueueBatchSize": 1000
    }
  },
  "AllowedHosts": "*"
}
